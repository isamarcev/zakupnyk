# Налаштування Zakupnyk (необов'язково — є безпечні дефолти)
# Каталог даних: база procflow.db та files/ з документами
PROCFLOW_DATA_DIR=data
# Адреса локального веб-сервера
PROCFLOW_HOST=127.0.0.1
PROCFLOW_PORT=8077
# Відкривати браузер при старті (false у Docker)
PROCFLOW_OPEN_BROWSER=true
# Зовнішній порт для docker compose
PROCFLOW_PUBLIC_PORT=8077
